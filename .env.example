# Copy to .env and set only the values you want to override.
#
# Inline values (convenient, but visible via `docker inspect`/`ps`):
XONOTIC_HOSTNAME=
XONOTIC_JOIN_PASSWORD=
XONOTIC_RCON_PASSWORD=
#
# Secret-file values (preferred for passwords): point at a mounted file, e.g.
# a Docker secret at /run/secrets/rcon_password. These take precedence over the
# inline values above.
XONOTIC_HOSTNAME_FILE=
XONOTIC_JOIN_PASSWORD_FILE=
XONOTIC_RCON_PASSWORD_FILE=
